<section class="socket-slot-config-layout" data-application-part="form">
  <div class="slotcfg-body">
    <nav class="slotcfg-rail" aria-label="{{strings.railTitle}}">
      <span class="slotcfg-rail-title">{{strings.railTitle}}</span>
      <div class="slotcfg-rail-list">
        {{#each railSlots as |rail|}}
          <button
            type="button"
            class="slotcfg-rail-item {{#if rail.active}}is-active{{/if}}"
            data-action="selectSlot"
            data-index="{{rail.index}}"
          >
            <span class="slotcfg-rail-diamond" {{#if rail.color}}style="--slotcfg-tint: {{rail.color}};"{{/if}}></span>
            <span class="slotcfg-rail-meta">
              <span class="slotcfg-rail-name">{{rail.name}}</span>
              <span class="slotcfg-rail-gem">{{rail.gemLabel}}</span>
            </span>
            {{#if rail.hidden}}
              <i class="fa-solid fa-eye-slash slotcfg-rail-hidden" data-tooltip="{{../strings.hiddenLabel}}"></i>
            {{/if}}
          </button>
        {{/each}}
      </div>
      {{#if canAddSocket}}
        <div class="slotcfg-rail-foot">
          <button type="button" class="slotcfg-btn slotcfg-btn--secondary slotcfg-btn--sm slotcfg-btn--block" data-action="addSocket">
            <i class="fas fa-plus"></i> {{strings.addSocket}}
          </button>
        </div>
      {{/if}}
    </nav>

    <div class="slotcfg-config">
      <div class="slotcfg-identity">
        <div
          class="sc-sockets-slot-visual slotcfg-tile {{#if previewHasTint}}has-slot-tint{{/if}}"
          data-slot-color-preview
          {{#if previewStyle}}style="{{previewStyle}}"{{/if}}
          aria-label="{{strings.previewLabel}}"
        >
          <img class="sc-sockets-slot-frame {{#if previewHasTint}}is-tinted{{/if}}" src="{{slotFrameImg}}" alt="{{strings.previewLabel}}">
          {{#if hasGem}}
            <img class="sc-sockets-slot-gem" src="{{gemImg}}" alt="{{gemName}}">
          {{/if}}
        </div>
        <div class="slotcfg-identity-fields">
          <label class="slotcfg-flabel" for="{{appId}}-slot-name">{{strings.slotNameLabel}}</label>
          <input
            id="{{appId}}-slot-name"
            type="text"
            name="slotConfig.name"
            class="slotcfg-input"
            value="{{slotConfigName}}"
            placeholder="{{strings.slotLabel}} {{slotNumber}}"
            autocomplete="off"
            {{#unless editable}}disabled{{/unless}}
          />
          <span class="slotcfg-hint">{{strings.slotNameHint}}</span>
        </div>
      </div>

      <div class="slotcfg-field">
        <span class="slotcfg-flabel">
          {{strings.colorLabel}}
          <i class="fa-solid fa-circle-info slotcfg-info" data-tooltip="{{strings.colorHint}}"></i>
        </span>
        <div class="slotcfg-tint-row">
          <div class="slotcfg-swatches">
            {{#each tintSwatches as |swatch|}}
              <button
                type="button"
                class="slotcfg-swatch {{#if swatch.active}}is-active{{/if}}"
                data-action="pickTint"
                data-color="{{swatch.value}}"
                data-tooltip="{{swatch.value}}"
                style="--slotcfg-swatch: {{swatch.value}};"
                {{#unless ../editable}}disabled{{/unless}}
              ></button>
            {{/each}}
          </div>
          <div class="slotcfg-tint-controls">
            <input
              type="text"
              name="slotConfig.colorHex"
              class="slotcfg-input slotcfg-input--hex"
              value="{{color}}"
              placeholder="#D4AF37"
              autocomplete="off"
              aria-label="{{strings.colorHexLabel}}"
              {{#unless editable}}disabled{{/unless}}
            />
            <input
              type="color"
              name="slotConfig.colorPicker"
              class="slotcfg-color-picker"
              value="{{colorPickerValue}}"
              aria-label="{{strings.colorPickerLabel}}"
              {{#unless editable}}disabled{{/unless}}
            />
            <button
              type="button"
              class="slotcfg-iconbtn"
              data-action="clearColor"
              aria-label="{{strings.clearColor}}"
              data-tooltip="{{strings.clearColor}}"
              {{#unless editable}}disabled{{/unless}}
            >
              <i class="fas fa-eraser"></i>
            </button>
          </div>
        </div>
      </div>

      <div class="slotcfg-rule"></div>

      <div class="slotcfg-section">
        <div class="slotcfg-section-head">
          <span class="slotcfg-section-title">{{strings.contentsLabel}}</span>
          {{#if hasGem}}
            <span class="slotcfg-badge slotcfg-badge--accent">{{strings.socketedBadge}}</span>
          {{else}}
            <span class="slotcfg-badge">{{strings.emptyBadge}}</span>
          {{/if}}
        </div>
        <div class="slotcfg-card">
          <div class="slotcfg-docrow">
            <span class="slotcfg-docrow-icon">
              <img src="{{hostItemImg}}" alt="{{hostItemName}}">
            </span>
            <span class="slotcfg-docrow-meta">
              <span class="slotcfg-docrow-label">{{strings.hostLabel}}</span>
              <span class="slotcfg-docrow-name">{{hostItemName}}</span>
            </span>
            {{#if canInspectHost}}
              <span class="slotcfg-docrow-actions">
                <button type="button" class="slotcfg-iconbtn" data-action="inspectHost" aria-label="{{strings.inspectHost}}" data-tooltip="{{strings.inspectHostHint}}">
                  <i class="fas fa-eye"></i>
                </button>
              </span>
            {{/if}}
          </div>

          <div class="slotcfg-card-divider"></div>

          {{#if hasGem}}
            <div class="slotcfg-docrow slotcfg-docrow--gem">
              <span class="slotcfg-docrow-icon slotcfg-docrow-icon--gem">
                <img src="{{gemImg}}" alt="{{gemName}}">
              </span>
              <span class="slotcfg-docrow-meta">
                <span class="slotcfg-docrow-label">{{strings.gemLabel}}</span>
                <span class="slotcfg-docrow-name">{{gemName}}</span>
              </span>
              <span class="slotcfg-docrow-actions">
                {{#if canInspectGem}}
                  <button type="button" class="slotcfg-iconbtn" data-action="inspectGem" aria-label="{{strings.inspectGem}}" data-tooltip="{{localize 'SCSockets.SocketSlotConfig.InspectHint'}}">
                    <i class="fas fa-eye"></i>
                  </button>
                {{/if}}
                {{#if canUnsocketGem}}
                  <button type="button" class="slotcfg-iconbtn slotcfg-iconbtn--danger" data-action="unsocketGem" aria-label="{{strings.unsocketGem}}" data-tooltip="{{strings.unsocketGem}}">
                    <i class="fas fa-trash"></i>
                  </button>
                {{/if}}
              </span>
            </div>

            {{#if hasGemResource}}
              <div class="slotcfg-charges">
                <div class="slotcfg-charges-head">
                  <span class="slotcfg-flabel">
                    {{strings.gemChargesLabel}}
                    <i class="fa-solid fa-circle-info slotcfg-info" data-tooltip="{{strings.gemChargesHint}}"></i>
                  </span>
                  <span class="slotcfg-spacer"></span>
                  <button
                    type="button"
                    class="slotcfg-badge slotcfg-badge--mono slotcfg-badge--copy"
                    data-action="copyResourceKey"
                    data-key="{{gemResource.key}}"
                    data-tooltip="{{strings.copyKeyHint}}"
                  >{{gemResource.key}}</button>
                </div>
                <div class="slotcfg-charges-row">
                  <div class="slotcfg-stepper">
                    <button type="button" class="slotcfg-stepper-btn" data-action="gemChargeDelta" data-delta="-1" {{#unless editable}}disabled{{/unless}} aria-label="-1">
                      <i class="fas fa-minus"></i>
                    </button>
                    <input
                      type="number"
                      name="gemResource.value"
                      class="slotcfg-stepper-input"
                      value="{{gemResource.value}}"
                      min="0"
                      max="{{gemResource.max}}"
                      step="1"
                      {{#unless editable}}disabled{{/unless}}
                    />
                    <button type="button" class="slotcfg-stepper-btn" data-action="gemChargeDelta" data-delta="1" {{#unless editable}}disabled{{/unless}} aria-label="+1">
                      <i class="fas fa-plus"></i>
                    </button>
                  </div>
                  <span class="slotcfg-charges-max">/ {{gemResource.max}}</span>
                </div>
                <div class="slotcfg-bar">
                  <div class="slotcfg-bar-fill" data-gem-charges-bar style="width: {{gemChargesPct}}%;"></div>
                </div>
              </div>

              <div class="slotcfg-recovery">
                <span class="slotcfg-flabel">
                  {{strings.gemRecoveryLabel}}
                  <i class="fa-solid fa-circle-info slotcfg-info" data-tooltip="{{strings.gemRecoveryHint}}"></i>
                </span>
                <div class="slotcfg-recovery-controls">
                  <select
                    name="gemResource.recovery.period"
                    class="slotcfg-input slotcfg-recovery-period"
                    {{#unless editable}}disabled{{/unless}}
                  >
                    {{#each gemRecoveryPeriodGroups as |group|}}
                      {{#if group.label}}
                        <optgroup label="{{group.label}}">
                          {{#each group.options as |opt|}}
                            <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                          {{/each}}
                        </optgroup>
                      {{else}}
                        {{#each group.options as |opt|}}
                          <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                        {{/each}}
                      {{/if}}
                    {{/each}}
                  </select>
                  <input
                    type="number"
                    name="gemResource.recovery.threshold"
                    class="slotcfg-input slotcfg-recovery-threshold"
                    value="{{gemResource.recovery.threshold}}"
                    min="1" max="6" step="1"
                    placeholder="6"
                    {{#unless gemRecoveryIsRecharge}}hidden{{/unless}}
                    {{#unless editable}}disabled{{/unless}}
                  />
                  <select
                    name="gemResource.recovery.type"
                    class="slotcfg-input slotcfg-recovery-type"
                    {{#unless editable}}disabled{{/unless}}
                  >
                    {{#each gemRecoveryTypeOptions as |opt|}}
                      <option value="{{opt.value}}" {{#if opt.selected}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </select>
                  <input
                    type="text"
                    name="gemResource.recovery.formula"
                    class="slotcfg-input slotcfg-recovery-formula"
                    value="{{gemResource.recovery.formula}}"
                    placeholder="{{strings.gemRecoveryFormulaPlaceholder}}"
                    {{#unless gemRecoveryShowFormula}}hidden{{/unless}}
                    {{#unless editable}}disabled{{/unless}}
                  />
                </div>
              </div>
            {{/if}}
          {{else}}
            <div class="slotcfg-empty-drop" {{#if editable}}data-dropzone="slotcfg-gem" data-index="{{slotIndex}}"{{/if}}>
              <i class="fas fa-gem"></i>
              <span>{{strings.noGem}}</span>
              {{#if editable}}
                <span class="slotcfg-empty-drop-hint">{{strings.dropGemHint}}</span>
              {{/if}}
            </div>
          {{/if}}
        </div>
      </div>

      <div class="slotcfg-rule"></div>

      <div class="slotcfg-section">
        <div class="slotcfg-section-head">
          <span class="slotcfg-section-title">{{strings.rulesLabel}}</span>
        </div>

        <div class="slotcfg-switchrow">
          <span class="slotcfg-switchrow-text">
            <strong>
              {{strings.hiddenLabel}}
              <span class="slotcfg-badge slotcfg-badge--warn" data-hidden-badge {{#unless hidden}}hidden{{/unless}}>{{strings.hiddenBadge}}</span>
            </strong>
            <small>{{strings.hiddenHint}}</small>
          </span>
          <label class="slotcfg-toggle">
            <input
              type="checkbox"
              name="slotConfig.hidden"
              value="true"
              {{#if hidden}}checked{{/if}}
              {{#unless canEditVisibility}}disabled{{/unless}}
            />
            <span class="slotcfg-toggle-track"></span>
          </label>
        </div>

        <div class="slotcfg-card-divider"></div>

        <div class="slotcfg-switchrow">
          <span class="slotcfg-switchrow-text">
            <strong>
              {{strings.deleteGemOnRemovalLabel}}
              <span class="slotcfg-badge slotcfg-badge--warn" data-delete-gem-badge {{#unless deleteGemOnRemoval}}hidden{{/unless}}>{{strings.destructiveBadge}}</span>
            </strong>
            <small>{{strings.deleteGemOnRemovalHint}}</small>
          </span>
          <label class="slotcfg-toggle">
            <input
              type="checkbox"
              name="slotConfig.deleteGemOnRemoval"
              value="true"
              {{#if deleteGemOnRemoval}}checked{{/if}}
              {{#unless editable}}disabled{{/unless}}
            />
            <span class="slotcfg-toggle-track"></span>
          </label>
        </div>
      </div>
    </div>

    <div class="slotcfg-editors">
      <div class="slotcfg-tabs" role="tablist">
        <button type="button" class="slotcfg-tab {{#if tabDescActive}}is-active{{/if}}" data-action="switchTab" data-tab="desc" role="tab" aria-selected="{{tabDescActive}}">
          {{strings.tabDescription}}
        </button>
        <button type="button" class="slotcfg-tab {{#if tabCondActive}}is-active{{/if}}" data-action="switchTab" data-tab="cond" role="tab" aria-selected="{{tabCondActive}}">
          {{strings.tabCondition}}
        </button>
      </div>

      <div class="slotcfg-pane" data-tab-pane="desc" {{#unless tabDescActive}}hidden{{/unless}}>
        <div class="slotcfg-section-head">
          <span class="slotcfg-section-title">{{strings.descriptionLabel}}</span>
        </div>
        <p class="slotcfg-hint">{{strings.descriptionHint}}</p>
        <div class="slotcfg-editor-frame">
          {{#if editable}}
            <prose-mirror
              name="slotConfig.description"
              value="{{description}}"
              document-uuid="{{hostItemUuid}}"
              class="slotcfg-description-editor"
              compact
            >{{{descriptionEnriched}}}</prose-mirror>
          {{else}}
            <div class="editor editor-content slotcfg-description-preview">
              {{{descriptionEnriched}}}
            </div>
          {{/if}}
        </div>
      </div>

      <div class="slotcfg-pane" data-tab-pane="cond" {{#unless tabCondActive}}hidden{{/unless}}>
        <div class="slotcfg-section-head">
          <span class="slotcfg-section-title">{{strings.conditionLabel}}</span>
          <a
            href="{{conditionWikiUrl}}"
            target="_blank"
            rel="noopener"
            class="slotcfg-help-link"
          >
            <i class="fas fa-up-right-from-square"></i> {{strings.conditionWiki}}
          </a>
        </div>
        <p class="slotcfg-hint">{{strings.conditionHint}}</p>
        <div class="slotcfg-editor-frame">
          {{#if editable}}
            <code-mirror
              name="slotConfig.condition"
              language="javascript"
              indent="2"
              class="slotcfg-code"
              aria-label="{{strings.conditionLabel}}"
            >{{condition}}</code-mirror>
          {{else}}
            <textarea
              name="slotConfig.condition"
              class="slotcfg-code slotcfg-code--readonly"
              rows="10"
              placeholder="{{strings.conditionPlaceholder}}"
              disabled>{{condition}}</textarea>
          {{/if}}
        </div>
        {{#if editable}}
          <div class="slotcfg-insert">
            <span class="slotcfg-hint">{{strings.insertLabel}}</span>
            <div class="slotcfg-insert-chips">
              {{#each conditionVars as |cVar|}}
                <button
                  type="button"
                  class="slotcfg-chip"
                  data-action="insertConditionVar"
                  data-insert="{{cVar.snippet}}"
                  data-tooltip="{{cVar.tooltip}}"
                >{{cVar.label}}</button>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </div>
    </div>
  </div>

  <footer class="slotcfg-footer">
    <span class="slotcfg-spacer"></span>
    <button type="button" class="slotcfg-btn slotcfg-btn--secondary" data-action="close">
      <i class="fas fa-xmark"></i> {{strings.cancel}}
    </button>
    {{#if editable}}
      <button type="submit" class="slotcfg-btn slotcfg-btn--primary">
        <i class="fas fa-floppy-disk"></i> {{strings.save}}
      </button>
    {{/if}}
  </footer>
</section>
